# ======================================================
# VARIABLES REQUERIDAS (en producción)
# - JWT_SECRET
# - WHATSAPP_APP_SECRET
# - WHATSAPP_WEBHOOK_VERIFY_TOKEN
# - MONGODB_URI
# - GEMINI_API_KEY (solo si NODE_ENV=production o querés que el bot responda)
# Además, en producción CORS_ORIGIN debe apuntar al dominio del panel (nunca "*")
# ======================================================
# ===== Servidor =====
PORT=3000

# ===== Base de datos =====
MONGODB_URI=mongodb://localhost:27017/crm

# ===== Seguridad =====
# CLAVE SECRETA PARA JWT (CAMBIALA OBLIGATORIAMENTE)
JWT_SECRET=clave_secreta_super_segura_123

# ===== Meta / WhatsApp =====
# Token de acceso de WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=EAAG...
# App Secret de Meta (para validar firma del webhook)
WHATSAPP_APP_SECRET=...
# Token que configuraste en Meta para verificar el webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=...
# WABA ID global (opcional, puede guardarse por empresa)
WHATSAPP_WABA_ID=

# ===== IA (Gemini) =====
GEMINI_API_KEY=AIza...
# Modelos permitidos, separados por coma (opcional)
GEMINI_MODELOS=gemini-2.0-flash,gemini-1.5-flash

# ===== CORS =====
# Dominios permitidos separados por coma. NUNCA dejar * en producción.
CORS_ORIGIN=https://panel.midominio.com

# ===== Fallbacks de IA (opcionales) =====
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# ===== Logs =====
# Nivel mínimo de log: error, warn, info, debug
LOG_LEVEL=info
# Webhook opcional para enviar logs (Sentry, Logtail, Datadog, etc.)
LOG_WEBHOOK_URL=
LOG_WEBHOOK_LEVEL=warn

# ===== Health Checks =====
# Umbral máximo de heap usado en MB (default: 1024)
HEALTH_MAX_HEAP_MB=1024
# Espacio mínimo disponible en disco para uploads en GB (default: 1)
HEALTH_MIN_DISK_GB=1
# Máximo de peticiones en espera en la cola de IA antes de marcar unhealthy (default: 50)
HEALTH_MAX_IA_QUEUE=50
